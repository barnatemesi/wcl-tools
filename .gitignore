# Allowlist: only the tools, guides and stats code are tracked. Logs, data and credentials (.env) stay local.
/*
!/.gitignore
!/LICENSE
!/README.md
!/recovered/
/recovered/*
!/recovered/tools/
/recovered/tools/.token-cache.json
!/guides/
# Per-player DPS of raid members, stays local
/guides/rotations/
!/thunderstrike-stats/
/thunderstrike-stats/data/
/thunderstrike-stats/.venv/
__pycache__/
.DS_Store
